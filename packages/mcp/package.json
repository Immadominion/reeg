{
  "name": "@reeg/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "The Reeg MCP server: create, checkpoint, restore, verify, share, fork, and retire agent environments — plus offline-verifiable evidence — as Model Context Protocol tools any agent can call.",
  "type": "module",
  "bin": {
    "reeg-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@mysten/seal": "^1.1.3",
    "@mysten/sui": "^2.17.0",
    "@mysten/walrus": "^1.1.7",
    "@reeg/chain": "workspace:*",
    "@reeg/crypto": "workspace:*",
    "@reeg/sdk": "workspace:*",
    "@reeg/storage": "workspace:*",
    "@reeg/verify": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
