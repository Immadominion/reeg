{
  "name": "@reeg/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The reeg CLI: create, run, checkpoint, restore, fork, verify, grant/revoke.",
  "type": "module",
  "bin": {
    "reeg": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mysten/seal": "^1.1.3",
    "@mysten/sui": "^2.17.0",
    "@mysten/walrus": "^1.1.7",
    "@reeg/chain": "workspace:*",
    "@reeg/crypto": "workspace:*",
    "@reeg/sdk": "workspace:*",
    "@reeg/storage": "workspace:*",
    "@reeg/verify": "workspace:*",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
