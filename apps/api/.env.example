# Reeg paymaster backend (apps/api). Copy to .env (gitignored) and fill in.
# The Enoki PRIVATE key lives ONLY here, never in the frontend or in git.

# Enoki private API key (enoki_private_...), features: Sponsored transactions. Server-side only.
ENOKI_SECRET_KEY=

# Enoki network for sponsorship: testnet | mainnet | devnet (free Enoki plan = testnet only).
ENOKI_NETWORK=testnet

# The Reeg Move package id. Sponsored move-call targets are built from this.
REEG_PACKAGE_ID=

# Optional: override the sponsored move-call targets (comma-separated module::function suffixes).
# Defaults to the Reeg core: machine::{create_owned,fork_owned,retire,register_checkpoint},
# access::{create_shared_machine,grant,revoke}.
# REEG_SPONSORED_TARGETS=machine::register_checkpoint,access::grant

# CORS: origins allowed to call the paymaster (the Console). Comma-separated.
REEG_ALLOWED_ORIGINS=http://localhost:5173,https://app.reeg.xyz

# Port to listen on.
PORT=8787
