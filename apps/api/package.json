{
  "name": "@reeg/api",
  "version": "0.0.0",
  "private": true,
  "description": "Reeg paymaster backend: Enoki-sponsored transactions and zkLogin helpers today; sponsored Walrus storage + metering later. The only privileged Reeg service; verification never depends on it.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@mysten/enoki": "^1.0.8",
    "@mysten/sui": "^2.17.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.25"
  }
}
