# Copy to .env and fill in. Never commit .env (see .gitignore).
# Network selection: testnet | mainnet. Code is identical across networks;
# only config/<network>.json and these values differ (see config/README.md).
REEG_NETWORK=testnet

# Operator signing key (client-side only; plaintext and keys never leave the client).
# Use a key manager in production. For local dev, a Sui keystore alias is fine.
SUI_KEYSTORE_ALIAS=

# Optional overrides; defaults come from config/<network>.json.
SUI_RPC_URL=
WALRUS_AGGREGATOR_URL=
WALRUS_PUBLISHER_URL=
